{
  "version": 2,
  "installCommand": "npm install --include=dev --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/console/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/v1/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/p/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/healthz",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

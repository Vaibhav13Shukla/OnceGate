{
  "version": 2,
  "installCommand": "npm install --include=dev --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/p/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/charge",
      "destination": "/api/index"
    },
    {
      "source": "/charges",
      "destination": "/api/index"
    },
    {
      "source": "/charges/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/healthz",
      "destination": "/api/index"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}

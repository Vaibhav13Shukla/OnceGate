# ==============================================================================
# OnceGate Environment Configuration Template
# Place a copy of this file at the root as `.env` for local development.
# On Vercel, set these in Project Settings -> Environment Variables.
# ==============================================================================

# 1. PostgreSQL Database Connection String (REQUIRED)
# For Supabase on Vercel, use the Transaction Pooler URI (Port 6543):
DATABASE_URL="postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Upstream API Target URL (REQUIRED for Proxying)
# Target HTTP service to forward mutating Idempotency-Key requests to:
UPSTREAM_BASE_URL="http://localhost:3100"

# 3. Control Plane Admin Bearer Token (OPTIONAL - Default: admin-secret)
# Secret key used by the Console UI to authenticate administrative operations:
ADMIN_TOKEN="admin-secret"

# 4. Gateway HTTP Port (OPTIONAL - Default: 3000)
PORT="3000"

# 5. Upstream Request Timeout in Milliseconds (OPTIONAL - Default: 10000)
UPSTREAM_TIMEOUT_MS="10000"

# 6. Idempotency Key TTL Retention in Hours (OPTIONAL - Default: 24)
KEY_TTL_HOURS="24"

# 7. CORS Allowed Origin (OPTIONAL - Default: *)
CORS_ORIGIN="*"

# 8. Console API Gateway Base URL (OPTIONAL - Leave empty on Vercel for same-origin proxy)
VITE_GATE_URL=""
